{
  "name": "deepsearch-worker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --ip 127.0.0.1",
    "test": "node --test test/worker.test.js",
    "test:integration": "node test/integration.js",
    "test:browser": "playwright test",
    "build": "npm run check && npm test",
    "check": "node --check src/worker.js && node --check public/app.js && node --check public/theme.js",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "wrangler": "^4.0.0"
  }
}
